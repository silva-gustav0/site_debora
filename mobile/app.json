{
  "expo": {
    "name": "Débora Equipe",
    "slug": "debora-equipe",
    "version": "2.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "deboraequipe",
    "userInterfaceStyle": "light",
    "android": {
      "package": "br.com.clinicadeborasilva.equipe",
      "versionCode": 4,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FBF7EE",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7EE",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2591fd05-8003-4854-b608-fc0922517240"
      }
    },
    "owner": "gustavoramalho",
    "updates": {
      "url": "https://u.expo.dev/2591fd05-8003-4854-b608-fc0922517240"
    },
    "ios": {},
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
