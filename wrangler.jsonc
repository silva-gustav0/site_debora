// Worker do site (Next.js via OpenNext). Publicar: `npm run deploy` (ou o GitHub Actions a cada push no master).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinica-debora",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "clinica-debora" }],
  // Otimização de imagens do next/image pelo Cloudflare Images.
  "images": { "binding": "IMAGES" },
  // O banco (Supabase) fica nos EUA: o Cloudflare roda o Worker perto dele, e cada consulta deixa de cruzar o continente.
  "placement": { "mode": "smart" },
  // Domínios do site (DNS e certificado gerenciados pelo Cloudflare).
  "routes": [
    { "pattern": "deborasilvaestetica.com.br", "custom_domain": true },
    { "pattern": "www.deborasilvaestetica.com.br", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
